# Copy to .env (scripts/setup.sh does this for you). Never commit .env.
LAB_USER=admin
LAB_PASSWORD=labpassword

# Implementation B (default, ARM64-safe): linux  |  Implementation A (cEOS): eos
SWITCH_MODE=linux
SWITCH_HOST=switch
SWITCH_PORT=22
# Interface used by the "Configure Test Interface Description" operation
#   linux mode: port1   |   eos mode: Ethernet1
SWITCH_TEST_INTERFACE=port1

CONTROLLER_URL=http://controller:8000
ROUTER_HOST=router
ROUTER_PORT=22

REQUEST_TIMEOUT=10
LOG_LEVEL=INFO
